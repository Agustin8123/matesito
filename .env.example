NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=matesito_8s
# Alternatively set DATABASE_URL.
# Set DB_SSL=false only when your PostgreSQL server intentionally uses no TLS.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
TURNSTILE_SECRET=
CORS_ORIGINS=https://matesito.com.ar,http://localhost,capacitor://localhost

# Persistent media storage; use an absolute path outside the checkout in production.
# UPLOAD_DIR=/var/lib/matesito/uploads
UPLOAD_MAX_MB=50
