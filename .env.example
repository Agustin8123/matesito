NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=matesito_8s
# Alternatively set DATABASE_URL.
# Set DB_SSL=false only when your PostgreSQL server intentionally uses no TLS.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
TURNSTILE_SECRET=
CORS_ORIGINS=https://matesito.com.ar,http://localhost,capacitor://localhost

# Persistent media storage; use an absolute path outside the checkout in production.
# UPLOAD_DIR=/var/lib/matesito/uploads
UPLOAD_MAX_MB=50

# Canonical origin for shared posts and sitemap.
PUBLIC_URL=https://matesito.com.ar

# IDs numéricos de las cuentas administradoras, separados por coma.
# También controla el acceso al panel interno. Sin IDs, queda restringido.
ADMIN_USER_IDS=
# Clave de API web de GIPHY; se entrega al navegador para buscar directamente.
GIPHY_API_KEY=
# Solo indicar proxies confiables; no usar true indiscriminadamente.
# TRUST_PROXY=loopback
# Ejecutable instalado con FFmpeg; necesario para subir audio/video nuevos.
# FFPROBE_PATH=/usr/bin/ffprobe
